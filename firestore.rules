rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function valido() {
      let d = request.resource.data;
      return d.keys().hasAll(['nombre','precio','categoria','disponible','propietarioId','creadoEn','actualizadoEn'])
        && d.keys().hasOnly(['nombre','precio','categoria','disponible','propietarioId','creadoEn','actualizadoEn'])
        && d.nombre is string && d.nombre.size() >= 3 && d.nombre.size() <= 100
        && d.precio is number && d.precio > 0
        && d.categoria is string && d.categoria.size() > 0 && d.categoria.size() <= 60
        && d.disponible is bool
        && d.propietarioId == request.auth.uid
        && d.creadoEn is timestamp && d.actualizadoEn == request.time;
    }
    match /productos/{id} {
      allow read, delete: if autenticado() && resource.data.propietarioId == request.auth.uid;
      allow create: if autenticado() && valido() && request.resource.data.creadoEn == request.time;
      allow update: if autenticado() && resource.data.propietarioId == request.auth.uid
        && valido() && request.resource.data.creadoEn == resource.data.creadoEn;
    }
  }
}
